rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'freedomedupu@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'super_admin')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Users collection: System accounts with protected deletions
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // 2. Students collection: Student candidate profiles with protected deletions
    match /students/{studentId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // 3. Admins collection: Institutional administrator accounts
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // 4. Competitions collection: Quizzes, Exams, Academic Olympiads & Challenges
    match /competitions/{competitionId} {
      allow read, write: if true;

      match /questions/{questionId} {
        allow read, write: if true;
      }

      match /participants/{participantId} {
        allow read, write: if true;
      }
    }

    // 5. Results collection: Exam scoring, rankings, and certificates
    match /results/{resultId} {
      allow read, write: if true;
    }

    // 6. Payments collection: Competition entry fees
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 7. Verification Photos collection: Web camera verification snapshots
    match /verificationPhotos/{verificationId} {
      allow read, write: if true;
    }

    // 8. Attempts collection: Real-time exam sessions and question answers
    match /attempts/{attemptId} {
      allow read, write: if true;
    }

    // 9. Platform Settings: Institutional configuration
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 10. Audit Logs: Immutable system activity trail
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false; // Strict immutability
    }

    // 11. Announcements collection: Institutional broadcasts and rewards
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // 12. Memberships collection: Student monthly membership records
    match /memberships/{membershipId} {
      allow read, write: if true;
    }

    // 13. Membership Payments collection: Monthly subscription requests
    match /membershipPayments/{paymentId} {
      allow read, write: if true;
    }

    // 14. Live Proctor Sessions: Real-time student exam monitoring and alerts
    match /liveProctorSessions/{sessionId} {
      allow read, write: if true;
    }

    // 15. Advertisements: Sponsor billboards and announcements
    match /advertisements/{adId} {
      allow read, write: if true;
    }

    // 16. Student Feedbacks collection: Student ratings, reviews, and questions
    match /student_feedbacks/{feedbackId} {
      allow read, write: if true;
    }
  }
}
